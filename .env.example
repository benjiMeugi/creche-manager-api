APP_NAME="Creche Manager API - Petite Lune"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=creche_manager_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# Service d'authentification centralisé (authentication-api)
AUTH_API_BASE_URL=http://authentication-api

# Paramètres métier Crèche Petite Lune (Fiche d'inscription)
CRECHE_OPENING_TIME=07:30
CRECHE_CLOSING_TIME=18:30
CRECHE_PICKUP_WINDOW_START=18:00
CRECHE_OVERTIME_HOURLY_RATE=2000
CRECHE_DAILY_MEAL_RATE=1500
CRECHE_REGISTRATION_FEE=50000
