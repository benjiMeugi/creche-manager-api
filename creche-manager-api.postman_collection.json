    {
      "name": "10 - Échéancier de Scolarité (4 Tranches - Section VIII PDF)",
      "item": [
        {
          "name": "Lister l'échéancier des tranches d'une inscription",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tuition_installment?query_={\"where\":{\"registration_id\":1}}",
              "host": ["{{base_url}}"],
              "path": ["tuition_installment"],
