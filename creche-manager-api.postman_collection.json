  "item": [
    {
      "name": "01 - Auth & Permissions (authentication-api)",
      "item": [
        {
          "name": "1. Login sur authentication-api (Récupère le token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.body && jsonData.body.response_data && jsonData.body.response_data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.body.response_data.token);",
                  "} else if (jsonData && jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{auth_api_url}}/login",
              "host": ["{{auth_api_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "2. Mes Permissions sur creche-manager-api",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/permissions",
              "host": ["{{base_url}}"],
              "path": ["permissions"]
            }
          }
        },
        {
          "name": "3. Profil employé connecté (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Sections & Grille Tarifaire (Section VIII PDF)",
      "item": [
        {
          "name": "Lister toutes les sections (3-12m, 1-2a, 2-3a, 3-4a)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/section",
              "host": ["{{base_url}}"],
              "path": ["section"]
            }
          }
        },
        {
          "name": "Filtrer une section avec query_ (BenjiMeugi Parser)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/section?query_={\"where\":{\"code\":\"3-12_months\"},\"withCount\":[\"children\"]}",
              "host": ["{{base_url}}"],
              "path": ["section"],
              "query": [
                {
                  "key": "query_",
                  "value": "{\"where\":{\"code\":\"3-12_months\"},\"withCount\":[\"children\"]}"
                }
              ]
            }
          }
        },
        {
          "name": "Détail d'une section",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/section/1",
              "host": ["{{base_url}}"],
              "path": ["section", "1"]
            }
          }
        }
      ]
    },
